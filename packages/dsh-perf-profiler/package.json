{
  "name": "dsh-perf-profiler",
  "displayName": "DSH Perf Profiler",
  "description": "DeepSeek Harness 性能剖析插件：记录每次工具调用、模型流式请求与审批等待的耗时，输出 JSONL / summary 供分析。",
  "version": "0.1.0",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "profiler",
    "performance"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
